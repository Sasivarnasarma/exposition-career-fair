{
  "name": "exposition-career-fair",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "check:ci": "pnpm check && pnpm db:validate && pnpm test && pnpm build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:check": "node --conditions=react-server --import tsx scripts/check-database.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "db:verify": "node --conditions=react-server --import tsx scripts/verify-database.ts",
    "admin:provision": "node --conditions=react-server --import tsx scripts/provision-super-admin.ts",
    "auth:verify": "node --conditions=react-server --import tsx scripts/verify-auth.ts",
    "registration:verify": "node --conditions=react-server --import tsx scripts/verify-registration.ts",
    "email:work": "node --conditions=react-server --import tsx scripts/work-emails.ts",
    "email:preview": "node --import tsx scripts/preview-emails.ts",
    "email:test": "node --conditions=react-server --import tsx scripts/test-email.ts",
    "assets:report": "node --import tsx scripts/report-assets.ts",
    "audit:security": "pnpm audit --audit-level=high",
    "http:verify": "node --conditions=react-server --import tsx scripts/verify-http.ts",
    "turnstile:verify": "node --conditions=react-server --import tsx scripts/verify-turnstile.ts",
    "admin:verify": "node --conditions=react-server --import tsx scripts/verify-admin.ts",
    "email:verify": "node --conditions=react-server --import tsx scripts/verify-email-lifecycle.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.75.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "resend": "^6.39.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.7.0"
}
