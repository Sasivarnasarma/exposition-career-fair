BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
RESEND_API_KEY=""
EMAIL_FROM=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=""

# Turnstile configuration; keep the secret server-only.
