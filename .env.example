# Fill these values when configuring backend services.
DATABASE_URL="postgresql://postgres:password@localhost:5432/exposition_career_fair"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
RESEND_API_KEY=""
EMAIL_FROM=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=""

# Turnstile configuration; keep the secret server-only.
# Public test keys are for local development only; production rejects them.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_ALLOWED_HOSTNAMES=""

# PostgreSQL: optional migration/session URL and verified TLS CA certificate file.
DIRECT_DATABASE_URL=""
DATABASE_CA_CERT_FILE=""
DATABASE_POOL_MAX="5"
# Required before enabling public submissions; use a random secret of 32+ characters.
RATE_LIMIT_SECRET=""
# Leave unset until the hosting proxy is verified to replace this header.
TRUSTED_CLIENT_IP_HEADER=""

# Registration stays closed until site and event launch gates are enabled.
REGISTRATION_EVENT_ID="issue-22-2027"
REGISTRATION_RECEIPT_SECRET=""
# Local development only; never enables production registration.
REGISTRATION_DEV_PREVIEW="false"

# Transactional email delivery; enable after sender and delivery checks.
RESEND_FROM_EMAIL=""
FROM_NAME="Exposition Career Fair Team"
EMAIL_DELIVERY_ENABLED="false"
# Exactly 64 random hex characters for encrypted queued links.
EMAIL_PAYLOAD_SECRET=""
# Non-production live sends are restricted to this approved recipient.
EMAIL_TEST_RECIPIENT=""
CRON_SECRET=""
